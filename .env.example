# Discord bot token, from the Discord Developer Portal.
DISCORD_TOKEN=

# The guild (server) Aurora operates in.
GUILD_ID=

# Optional: a channel Aurora posts logs to. Leave blank to disable.
LOGS_CHANNEL_ID=

# Log level for internal libraries
GENERAL_LOG_LEVEL=INFO

# Log level for aurora
LOG_LEVEL=DEBUG

# Model to use, e.g. qwen3.5:9b for Ollama, or gpt-4o-mini for OpenAI
MODEL_NAME=qwen3.5:9b

# OpenAI-compatible endpoint. Leave blank for Ollama default.
MODEL_BASE_URL=

# API key for the model provider. Not needed for local Ollama.
MODEL_API_KEY=